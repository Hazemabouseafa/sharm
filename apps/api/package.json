    "@sharm/contracts": "workspace:*",
    "@sharm/database": "workspace:*",
    "argon2": "0.44.0",
    "cookie-parser": "1.4.7",
    "dotenv": "16.5.0",
    "multer": "2.0.2",
    "nodemailer": "10.6.0",
    "otplib": "12.0.1",
    "pdfkit": "0.20.2",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sanitize-html": "2.17.0",
    "sharp": "0.34.5",
