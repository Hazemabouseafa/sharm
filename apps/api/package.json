  "devDependencies": {
    "@types/cookie-parser": "1.4.8",
    "@types/express": "5.0.2",
    "@types/multer": "1.4.12",
    "@types/nodemailer": "6.4.17",
    "@types/pdfkit": "0.17.2",
    "@types/qrcode": "1.5.5",
    "@types/sanitize-html": "2.16.0",
    "tsx": "4.23.15",
    "typescript": "5.8.3"
  }
