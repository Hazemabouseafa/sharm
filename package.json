{
  "name": "sharm-pharaoh-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev-all.mjs",
    "dev:api": "pnpm --filter @sharm/api dev",
    "dev:web": "pnpm --filter @sharm/web dev",
    "dev:worker": "pnpm --filter @sharm/worker dev",
    "mail:local": "node scripts/local-mail-capture.mjs",
    "build": "pnpm --filter @sharm/contracts build && pnpm --filter @sharm/database build && pnpm --filter @sharm/ui build && pnpm --filter @sharm/api build && pnpm --filter @sharm/worker build && pnpm --filter @sharm/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @sharm/database generate",
    "db:migrate:deploy": "pnpm --filter @sharm/database migrate:deploy",
    "db:migrate:dev": "pnpm --filter @sharm/database migrate:dev",
    "db:seed:demo": "pnpm --filter @sharm/database seed:demo",
    "db:seed:prod-init": "pnpm --filter @sharm/database seed:prod-init",
    "admin:create": "node scripts/create-admin.mjs",
    "assets:process": "node scripts/process-assets.mjs",
    "openapi:generate": "pnpm --filter @sharm/api openapi:generate",
    "test:unit": "vitest run --config vitest.config.ts tests/unit",
    "test:integration": "vitest run --config vitest.integration.config.ts tests/integration",
    "test:e2e": "playwright test",
    "test:all": "pnpm test:unit && pnpm test:integration && pnpm test:e2e",
    "backup:run": "node scripts/backup-encrypted.mjs",
    "backup:restore-verify": "node scripts/restore-verify.mjs",
    "live:prepare": "node scripts/prepare-live-operation.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.59.1",
    "@prisma/client": "6.19.3",
    "@sharm/api": "workspace:*",
    "@sharm/contracts": "workspace:*",
    "@sharm/database": "workspace:*",
    "@types/node": "22.15.3",
    "@types/supertest": "6.0.3",
    "argon2": "0.44.0",
    "otplib": "12.0.1",
    "playwright": "1.59.1",
    "sharp": "0.34.5",
    "supertest": "7.1.4",
    "tsx": "4.23.15",
    "typescript": "5.8.3",
    "vitest": "3.2.7"
  },
  "pnpm": {
    "overrides": {
      "magic-string": "0.30.19",
      "temporal-polyfill": "0.3.0",
      "vite": "6.3.5"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "argon2",
      "esbuild",
      "prisma",
      "sharp"
    ]
  }
}
