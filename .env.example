# =============================================================================
# Sharm Pharaoh Travel — Environment Configuration Template
# Copy to .env and replace placeholder values before running.
# NEVER commit real credentials, SMTP passwords, or payment secrets.
# =============================================================================

# Runtime mode: development | test | staging | production
NODE_ENV=development

# Explicit demo mode guard (MUST be false in production)
DEMO_MODE=false

# Public single-origin URL served to browsers (reverse proxy routes /api/v1 -> API, rest -> Web)
PUBLIC_SITE_URL=http://localhost:3000

# Internal service URLs (private Docker network or localhost)
API_PORT=4000
API_INTERNAL_URL=http://127.0.0.1:4000
WEB_PORT=3000
WEB_INTERNAL_URL=http://127.0.0.1:3000

# PostgreSQL connection strings
# Production/Dev database
DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:55432/sharm_pharaoh_dev?schema=public&connection_limit=15
# Dedicated disposable database for automated tests (refuses to run against DATABASE_URL)
TEST_DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:55432/sharm_pharaoh_test?schema=public&connection_limit=10

# Required cryptographic secrets (generate 32+ byte random hex/base64 values)
SESSION_SECRET=REPLACE_WITH_64_HEX_CHAR_RANDOM_SECRET
CSRF_SECRET=REPLACE_WITH_64_HEX_CHAR_RANDOM_SECRET
PREVIEW_SIGNING_SECRET=REPLACE_WITH_64_HEX_CHAR_RANDOM_SECRET
REVALIDATION_SECRET=REPLACE_WITH_64_HEX_CHAR_RANDOM_SECRET
CREDENTIALS_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHAR_32_BYTE_AES256_KEY
BACKUP_ENCRYPTION_PASSPHRASE=REPLACE_WITH_STRONG_BACKUP_PASSPHRASE

# Cookie & Proxy security
# Use 'auto' behind HTTPS proxies/localhost (or force 'true' / 'false')
COOKIE_SECURE=auto
TRUST_PROXY_HOPS=1

# Storage paths (use durable mounted volumes in Docker/Coolify)
STORAGE_PUBLIC_DIR=./.local-storage/public
STORAGE_PRIVATE_DIR=./.local-storage/private
MAX_UPLOAD_MB=10

# Email / SMTP (use Mailpit or scripts/local-mail-capture.mjs locally)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Sharm Pharaoh Travel <reservations@sharmpharaoh.com>"
MAILPIT_API_URL=http://127.0.0.1:8025

# Worker concurrency (keep 1-2 on shared VPS)
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=2000

# Optional Paymob Online Payment Gateway (leave blank until real merchant account is ready)
# Online checkout stays disabled and clearly labeled "Not configured" until valid credentials + sandbox verification exist
PAYMOB_ENABLED=false
PAYMOB_API_BASE_URL=https://accept.paymob.com
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID=
PAYMOB_CURRENCY=USD
PAYMOB_SANDBOX_VERIFIED=false
